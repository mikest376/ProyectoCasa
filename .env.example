# =============================================================================
# Odoo Data Lakehouse · plantilla de variables de entorno
#
#   cp .env.example .env      y sustituye todos los CHANGE_ME
#
# - .env está en .gitignore: nunca se sube al repositorio.
# - Usa contraseñas alfanuméricas (sin $ # ' " @ : /) para evitar problemas de
#   interpolación en Compose y en URLs de conexión.
#   Generar una:  openssl rand -hex 24
# - Los límites de memoria no se configuran aquí: son fijos en docker-compose.yml.
# =============================================================================

# --- General -----------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO
# Perfiles que arrancan por defecto. Sin definir, no arranca ningún servicio.
# COMPOSE_PROFILES=source,streaming

# --- Origen: Odoo 17 + PostgreSQL 15 (Fase 1) --------------------------------
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME
# Contraseña maestra de Odoo (admin_passwd), para gestionar bases de datos.
ODOO_MASTER_PASSWORD=CHANGE_ME
ODOO_DB_PORT_HOST=5433
ODOO_PORT_HOST=8069

# --- CDC: Debezium (Fase 1) --------------------------------------------------
# Rol de PostgreSQL dedicado: REPLICATION + SELECT, sin permisos de escritura.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=CHANGE_ME
DEBEZIUM_CONNECTOR_NAME=odoo-postgres-cdc
DEBEZIUM_TOPIC_PREFIX=odoo
DEBEZIUM_SLOT_NAME=debezium_odoo
DEBEZIUM_PUBLICATION_NAME=debezium_odoo_pub
# Captura global: todas las tablas del esquema, sin table.include.list.
DEBEZIUM_SCHEMA_INCLUDE_LIST=public
CONNECT_PORT_HOST=8083

# --- Streaming: Kafka en modo KRaft (Fase 1) ---------------------------------
# Identificador del clúster (no es secreto). No cambiar con datos ya creados.
KAFKA_CLUSTER_ID=J7R2EtwWSLGXyX7IzOQyew
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_PORT_HOST=9092
KAFKA_LOG_RETENTION_HOURS=168

# --- Almacenamiento: MinIO / S3 (Fase 2) -------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
# En el MVP coinciden con las credenciales raíz de MinIO (ver TD-014).
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold

# --- Worker Medallion (Fases 2 y 3) ------------------------------------------
WORKER_CONSUMER_GROUP=medallion-worker
WORKER_TOPIC_PATTERN='^odoo\.public\..*'
WORKER_BATCH_MAX_RECORDS=5000
WORKER_BATCH_MAX_SECONDS=30

# --- Catálogo: Unity Catalog OSS (Fase 3) ------------------------------------
UNITY_CATALOG_URL=http://unity-catalog:8080
UNITY_CATALOG_NAME=lakehouse
UNITY_CATALOG_PORT_HOST=8081

# --- Motor de consulta: Trino (Fase 3) ---------------------------------------
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=text2sql
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=gold
TRINO_PORT_HOST=8080

# --- IA: Ollama (Fase 4) -----------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Modelo aprobado. No cabe completo en una GPU de 6 GB (ver TD-001).
# Alternativa que sí cabe: qwen2.5-coder:3b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_PORT_HOST=11434

# --- Backend: FastAPI (Fase 4) -----------------------------------------------
BACKEND_PORT_HOST=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=60

# --- Frontend: Next.js (Fase 5) ----------------------------------------------
FRONTEND_PORT_HOST=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
