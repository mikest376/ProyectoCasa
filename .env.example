# =============================================================================
# Odoo Data Lakehouse · plantilla de variables de entorno
#
#   cp .env.example .env && chmod 600 .env      y sustituye todos los CHANGE_ME
#
# - .env está en .gitignore: nunca se sube al repositorio.
# - Usa contraseñas alfanuméricas (sin $ # ' " @ : /) para evitar problemas de
#   interpolación en Compose y en URLs de conexión.
#   Generar una:  openssl rand -hex 24
# - Los límites de memoria no se configuran aquí: son fijos en docker-compose.yml.
# - Comprobar el resultado:  scripts/check_env.sh
# =============================================================================

# --- General -----------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO
# Perfiles que arrancan por defecto. Sin definir, no arranca ningún servicio.
# COMPOSE_PROFILES=source,streaming

# --- Origen: PostgreSQL 15 ---------------------------------------------------
# Superusuario "postgres": solo administración y preparación del CDC.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ODOO_DB_PORT_HOST=5433

# --- Origen: Odoo 17 ---------------------------------------------------------
# Rol propietario de su base, sin superusuario.
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME
# Contraseña maestra (admin_passwd). El gestor de bases de datos está desactivado.
ODOO_MASTER_PASSWORD=CHANGE_ME
# Contraseña del usuario "admin" de Odoo. Mínimo 12 caracteres.
ODOO_ADMIN_PASSWORD=CHANGE_ME
ODOO_MODULES=contacts,crm,sale_management,account,stock
ODOO_PORT_HOST=8069

# --- CDC: Debezium -----------------------------------------------------------
# Rol de PostgreSQL dedicado: REPLICATION + SELECT, sin permisos de escritura.
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=CHANGE_ME
DEBEZIUM_CONNECTOR_NAME=odoo-postgres-cdc
DEBEZIUM_TOPIC_PREFIX=odoo
DEBEZIUM_SLOT_NAME=debezium_odoo
DEBEZIUM_PUBLICATION_NAME=debezium_odoo_pub
# Captura global: todas las tablas del esquema, sin table.include.list.
# Las columnas con secretos se excluyen en infra/debezium/column-exclude.list.
DEBEZIUM_SCHEMA_INCLUDE_LIST=public
CONNECT_PORT_HOST=8083

# --- Streaming: Kafka en modo KRaft ------------------------------------------
# Identificador del clúster (no es secreto). No cambiar con datos ya creados.
KAFKA_CLUSTER_ID=J7R2EtwWSLGXyX7IzOQyew
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_PORT_HOST=9092
KAFKA_LOG_RETENTION_HOURS=168

# --- Almacenamiento: MinIO / S3 (Fase 2) -------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
# En el MVP coinciden con las credenciales raíz de MinIO (ver TD-014).
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold

# --- Worker Medallion (Fases 1 a 3) ------------------------------------------
WORKER_CONSUMER_GROUP=medallion-worker
WORKER_TOPIC_PATTERN='^odoo\.public\..*'
WORKER_BATCH_MAX_RECORDS=5000
WORKER_BATCH_MAX_SECONDS=30

# --- Catálogo: Unity Catalog OSS (Fase 3) ------------------------------------
UNITY_CATALOG_URL=http://unity-catalog:8080
UNITY_CATALOG_NAME=lakehouse
UNITY_CATALOG_PORT_HOST=8081

# --- Motor de consulta: Trino (Fase 3) ---------------------------------------
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=text2sql
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=gold
TRINO_PORT_HOST=8080

# --- LLM: proveedor ----------------------------------------------------------
# ollama  local, con GPU. Los datos no salen del host (por defecto).
# nim     API de NVIDIA. Envía el esquema de Gold y la pregunta a un tercero
#         (ver TD-021). Solo con datos de demostración.
LLM_PROVIDER=ollama
LLM_REQUEST_TIMEOUT_SECONDS=120

# Ollama. El modelo 3B cabe en la VRAM libre de una GPU de 6 GB (ver TD-001).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_PORT_HOST=11434

# NVIDIA NIM. La clave (nvapi-...) se obtiene en https://build.nvidia.com
# Déjala vacía si LLM_PROVIDER=ollama.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_API_KEY=

# --- Backend: FastAPI --------------------------------------------------------
BACKEND_PORT_HOST=8000
# Solo para desarrollo local. Tras Caddy, la interfaz y la API comparten origen.
BACKEND_CORS_ORIGINS=http://localhost:3000
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=60

# --- Frontend: Next.js -------------------------------------------------------
FRONTEND_PORT_HOST=3000
BACKEND_INTERNAL_URL=http://backend:8000

# --- Observabilidad del LLM: Langfuse 2 --------------------------------------
# Sin parches de seguridad (ver TD-023): solo en 127.0.0.1 y con datos de demostración.
LANGFUSE_PORT_HOST=3001
LANGFUSE_DB_PASSWORD=CHANGE_ME
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
# Exactamente 64 caracteres hexadecimales:  openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
# Usuario inicial de la interfaz web
LANGFUSE_USER_EMAIL=admin@example.org
LANGFUSE_USER_PASSWORD=CHANGE_ME
# Claves del proyecto: pk-lf-<valor> y sk-lf-<valor>
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME

# --- Entrada externa: Caddy --------------------------------------------------
# 127.0.0.1 = solo este equipo. Para la defensa del TFG, y solo mientras dure, la
# IP de este equipo en la red local (192.168.1.24). Lee antes el README.
CADDY_BIND_IP=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Nombres públicos durante la defensa, por ejemplo app.example.org
CADDY_APP_HOST=app.localhost
CADDY_ODOO_HOST=odoo.localhost
# internal = certificado propio. Un correo electrónico activa Let's Encrypt.
CADDY_TLS=internal
# Contraseña de acceso. El hash va entre comillas simples porque contiene $.
#   docker run --rm -it caddy:2.11.9-alpine caddy hash-password
CADDY_BASIC_AUTH_USER=CHANGE_ME
CADDY_BASIC_AUTH_HASH='CHANGE_ME'
