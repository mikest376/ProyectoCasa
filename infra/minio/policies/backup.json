{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListEveryLayer",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@BRONZE@", "arn:aws:s3:::@SILVER@", "arn:aws:s3:::@GOLD@"]
    },
    {
      "Sid": "ReadEveryLayer",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::@BRONZE@/*", "arn:aws:s3:::@SILVER@/*", "arn:aws:s3:::@GOLD@/*"]
    }
  ]
}
