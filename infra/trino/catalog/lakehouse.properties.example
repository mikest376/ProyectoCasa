# PLANTILLA: Trino solo carga ficheros *.properties, así que este no se activa.
# En la Fase 3 se copia a lakehouse.properties y se valida (ver TD-002).
connector.name=delta_lake

# Metastore en ficheros sobre MinIO: existe en el código de Trino 484, pero la
# documentación oficial solo cubre "thrift" y "glue".
hive.metastore=file
hive.metastore.catalog.dir=s3://gold/_trino_metastore
delta.register-table-procedure.enabled=true

fs.s3.enabled=true
s3.endpoint=${ENV:S3_ENDPOINT_URL}
s3.region=${ENV:S3_REGION}
s3.path-style-access=true
s3.aws-access-key=${ENV:S3_ACCESS_KEY_ID}
s3.aws-secret-key=${ENV:S3_SECRET_ACCESS_KEY}
